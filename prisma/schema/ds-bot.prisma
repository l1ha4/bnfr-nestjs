model DsBot {
  id String @id @default(uuid())

  secretTokenBot String  @unique @map("token_secret_bot")
  name           String?
  avatarUrl      String? @map("avatar_url")
  isActive       Boolean @default(true) @map("is_active")
  isEnabled      Boolean @default(true) @map("is_enabled")
  isLoadingSync  Boolean @default(true) @map("is_loading_sync")

  guildConnections DsBotGuildConnection[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ds_bots")
}

model DsGuild {
  id String @id @default(uuid())

  isLoadingSync Boolean @default(true) @map("is_loading_sync")

  guildId String @unique @map("guild_id")

  name        String
  iconUrl     String? @map("icon_url")
  ownerId     String? @map("owner_id")
  memberCount Int     @default(0) @map("member_count")

  connections DsBotGuildConnection[]

  members  DsGuildMember[]
  roles    DsGuildRole[]
  channels DsGuildChannel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ds_guilds")
}

model DsBotGuildConnection {
  id String @id @default(uuid())

  botId String @map("bot_id")
  bot   DsBot  @relation(fields: [botId], references: [id], onDelete: Cascade)

  guildDbId String  @map("guild_db_id")
  guild     DsGuild @relation(fields: [guildDbId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true) @map("is_active")

  settings DsBotGuildSettings?

  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  dsBotMessageDispatches DsBotMessageDispatch[]

  @@unique([botId, guildDbId])
  @@map("ds_bot_guild_connections")
}

model DsUser {
  id String @id @default(uuid())

  userId String @unique @map("user_id")

  username   String
  globalName String? @map("global_name")
  avatarUrl  String? @map("avatar_url")

  isBot     Boolean @default(false) @map("is_bot")
  isUserBot Boolean @default(false) @map("is_user_bot")

  guildMemberships DsGuildMember[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ds_users")
}

model DsGuildMember {
  id String @id @default(uuid())

  guildDbId String  @map("guild_db_id")
  guild     DsGuild @relation(fields: [guildDbId], references: [id], onDelete: Cascade)

  userDbId String @map("user_db_id")
  user     DsUser @relation(fields: [userDbId], references: [id], onDelete: Cascade)

  displayName String? @map("display_name")

  isActive Boolean @default(true) @map("is_active")

  joinedAt DateTime? @map("joined_at")

  roles         DsGuildMemberRole[]
  voiceSessions DsGuildVoiceSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([guildDbId, userDbId])
  @@map("ds_guild_members")
}

model DsGuildMemberRole {
  memberId String @map("member_id")
  roleId   String @map("role_id")

  member DsGuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   DsGuildRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([memberId, roleId])
  @@map("ds_guild_member_roles")
}

model DsGuildRole {
  id String @id @default(uuid())

  guildDbId String  @map("guild_db_id")
  guild     DsGuild @relation(fields: [guildDbId], references: [id], onDelete: Cascade)

  roleId String @map("role_id")

  name      String
  color     Int?
  position  Int
  isManaged Boolean @default(false) @map("is_managed")
  isActive  Boolean @default(true) @map("is_active")

  members DsGuildMemberRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([guildDbId, roleId])
  @@map("ds_guild_roles")
}

model DsBotGuildSettings {
  id String @id @default(uuid())

  connectionId String               @unique @map("connection_id")
  connection   DsBotGuildConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  voiceTrackingEnabled Boolean @default(false) @map("voice_activity_tracking_enabled")
  messageModuleEnabled Boolean @default(false) @map("message_module_enabled")
  autoRoleEnabled      Boolean @default(false) @map("auto_role_enabled")
  tempVoiceEnabled     Boolean @default(false) @map("temp_voice_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ds_bot_guild_settings")
}

model DsGuildChannel {
  id String @id @default(uuid())

  guildDbId String  @map("guild_db_id")
  guild     DsGuild @relation(fields: [guildDbId], references: [id], onDelete: Cascade)

  channelId String @map("channel_id")

  name String?
  type DsGuildChannelType

  position        Int?
  parentChannelId String? @map("parent_channel_id")

  isTextBased     Boolean @default(false) @map("is_text_based")
  isVoiceBased    Boolean @default(false) @map("is_voice_based")
  isThread        Boolean @default(false) @map("is_thread")
  isThreadOnly    Boolean @default(false) @map("is_thread_only")
  canSendMessages Boolean @default(false) @map("can_send_messages")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([guildDbId, channelId])
  @@map("ds_guild_channels")
}

model DsGuildVoiceSession {
  id String @id @default(uuid())

  guildDbId String @map("guild_db_id")
  memberId  String @map("member_id")

  channelId String @map("channel_id")

  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")

  durationSeconds Int @default(0) @map("duration_seconds")

  isActive Boolean @default(true) @map("is_active")

  member DsGuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([guildDbId])
  @@index([memberId])
  @@index([channelId])
  @@map("ds_guild_voice_sessions")
}

enum DsGuildChannelType {
  TEXT
  VOICE
  CATEGORY
  ANNOUNCEMENT
  STAGE_VOICE
  FORUM
  MEDIA
  THREAD_PUBLIC
  THREAD_PRIVATE
  THREAD_ANNOUNCEMENT
  DIRECTORY
  UNKNOWN
}

model DsBotMessageTemplate {
  id String @id @default(uuid())

  creatorId String @map("creator_id")
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  name        String
  description String?

  type DsBotMessageBlockType

  contentJson Json @map("content_json")

  isPublic Boolean @default(false) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  formBlocks DsBotMessageFormBlock[]

  @@index([creatorId])
  @@index([isPublic])
  @@map("ds_bot_message_templates")
}

model DsBotMessageForm {
  id String @id @default(uuid())

  creatorId String @map("creator_id")
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  name        String
  description String?

  isPublic Boolean @default(false) @map("is_public")

  blocks DsBotMessageFormBlock[]

  dispatches DsBotMessageDispatch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([creatorId])
  @@index([isPublic])
  @@map("ds_bot_message_forms")
}

model DsBotMessageFormBlock {
  id String @id @default(uuid())

  formId String           @map("form_id")
  form   DsBotMessageForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  templateId String?               @map("template_id")
  template   DsBotMessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  type DsBotMessageBlockType

  contentJson Json? @map("content_json")

  position Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([formId, position])
  @@index([formId])
  @@index([templateId])
  @@map("ds_bot_message_form_blocks")
}

model DsBotMessageDispatch {
  id String @id @default(uuid())

  connectionId String               @map("connection_id")
  connection   DsBotGuildConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  channelId String @map("channel_id")

  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  sourceType DsBotMessageDispatchSourceType @map("source_type")

  formId String?           @map("form_id")
  form   DsBotMessageForm? @relation(fields: [formId], references: [id], onDelete: SetNull)

  status DsBotMessageDispatchStatus @default(SUCCESS)

  errorMessage String? @map("error_message")

  logs DsBotMessageLog[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([connectionId])
  @@index([channelId])
  @@index([createdById])
  @@index([formId])
  @@map("ds_bot_message_dispatches")
}

model DsBotMessageLog {
  id String @id @default(uuid())

  dispatchId String               @map("dispatch_id")
  dispatch   DsBotMessageDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  discordMessageId String @map("discord_message_id")
  discordChannelId String @map("discord_channel_id")

  position Int

  payloadJson Json @map("payload_json")

  status DsGuildMessageStatus @default(ACTIVE)

  isEditable Boolean @default(true) @map("is_editable")
  isDeleted  Boolean @default(false) @map("is_deleted")

  deletedAt DateTime? @map("deleted_at")
  editedAt DateTime? @map("edited_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([discordChannelId, discordMessageId])
  @@index([dispatchId])
  @@index([discordMessageId])
  @@index([discordChannelId])
  @@index([status])
  @@index([isDeleted])
  @@map("ds_bot_message_logs")
}

model DsGuildMessage {
  id String @id @default(uuid())

  guildDbId String @map("guild_db_id")

  channelId String @map("channel_id")
  messageId String @map("message_id")

  authorUserId String? @map("author_user_id")

  content String?

  isFromBot    Boolean @default(false) @map("is_from_bot")
  isFromOurBot Boolean @default(false) @map("is_from_our_bot")

  status DsGuildMessageStatus @default(ACTIVE)

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  sentAt   DateTime? @map("sent_at")
  editedAt DateTime? @map("edited_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([channelId, messageId])
  @@index([guildDbId])
  @@index([channelId])
  @@index([messageId])
  @@index([authorUserId])
  @@index([status])
  @@index([isDeleted])
  @@map("ds_guild_messages")
}

enum DsBotMessageBlockType {
  TEXT
  EMBED
}

enum DsBotMessageDispatchSourceType {
  FORM
  TEMPLATES
  INLINE
}

enum DsBotMessageDispatchStatus {
  SUCCESS
  FAILED
  PARTIAL
}

enum DsGuildMessageStatus {
  ACTIVE
  MESSAGE_DELETED
  CHANNEL_DELETED
  GUILD_DELETED
  GUILD_UNAVAILABLE
}
